---
import BaseLayout from '../layouts/BaseLayout.astro';
import {MonthlyChanges} from './MonthlyChanges';
import {buildChangesView,buildMonthlyChangesView,type CountryChangesViews} from '../lib/trade/changes';
import {monthlyChangesPath} from '../lib/trade/view-link';
import type {ProductDefinition} from '../lib/trade/product-registry';
import type {Release} from '../lib/trade/types';
interface Props{product:ProductDefinition;release:Release;products:ProductDefinition[]}
const {product,release,products}=Astro.props;
const views:CountryChangesViews={rolling:{imports:buildChangesView(release,'imports'),exports:buildChangesView(release,'exports')},monthly:{imports:buildMonthlyChangesView(release,'imports'),exports:buildMonthlyChangesView(release,'exports')}};
---
<BaseLayout title={`Monthly changes · ${product.displayName}`} description={`Explore changes in U.S. ${product.displayName} imports, exports and partner-country shares using sourced monthly and rolling twelve-month comparisons.`} productCode={release.productCode}>
  <div class="page-heading">
    <p class="eyebrow">MONTHLY RELEASE RESEARCH</p><h1>Monthly changes</h1>
    <p>{product.displayName} (HS {release.productCode}).</p>
    <details class="content-details product-definition"><summary>Official product description</summary><p class="heading-description">{views.rolling.imports.title}</p></details>
    <p>See which countries gained or lost value or share. Choose monthly or twelve-month comparisons below.</p>
    <a href={`/products/${release.productCode}/`}>View the full product profile</a>
  </div>
  <nav class="changes-products" aria-label="Changes products">
    <p>Product</p>
    <ul>{products.map(option=><li><a href={monthlyChangesPath(option.code)} aria-current={option.code===product.code?'page':undefined}>{option.displayName} · HS {option.code}</a></li>)}</ul>
    <p class="product-default-note">Switching products resets the filters to rolling import dollar changes.</p>
    <p><a href="/changes/products/">Compare changes across reviewed products</a></p>
  </nav>
  <MonthlyChanges data={JSON.stringify(views)} reportingMonth={release.reportingMonth} client:load/>
</BaseLayout>
<style>
  .changes-products{display:block;margin:0 0 24px}.changes-products p{font-size:13px;margin:0 0 10px}
  .changes-products ul{display:flex;flex-wrap:wrap;gap:12px;list-style:none;margin:0 0 12px;padding:0}
  .changes-products a{display:inline-block;padding:12px 16px;background:white;border:1px solid var(--border);border-radius:3px;line-height:1.5;overflow-wrap:anywhere}
  .changes-products a[aria-current="page"]{border-color:var(--teal);font-weight:600;color:var(--teal)}
  .changes-products .product-default-note{font-size:11px}
</style>
