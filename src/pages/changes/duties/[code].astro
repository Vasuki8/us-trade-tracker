---
import DutyChangesPage from '../../../components/DutyChangesPage.astro';
import {loadPublishedReleases} from '../../../lib/trade/load-release';
import {DEFAULT_PRODUCT_CODE} from '../../../lib/trade/product-registry';
export async function getStaticPaths(){
  const profiles=(await loadPublishedReleases()).filter(({product})=>product.dutiesAccepted);
  return profiles.filter(({product})=>product.code!==DEFAULT_PRODUCT_CODE).map(({product,release})=>({params:{code:product.code},props:{product,release,products:profiles.map(({product})=>product)}}));
}
const {product,release,products}=Astro.props;
---
<DutyChangesPage {product} {release} {products}/>
