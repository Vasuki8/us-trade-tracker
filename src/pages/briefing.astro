---
import BaseLayout from '../layouts/BaseLayout.astro';
import {ReleaseBriefing} from '../components/ReleaseBriefing';
import {loadRelease} from '../lib/trade/load-release';
import {monthLabel} from '../lib/trade/format';
const release=await loadRelease();
---
<BaseLayout title={`Coffee release briefing · ${monthLabel(release.reportingMonth)}`} description="A sourced briefing on U.S. roasted coffee imports, exports, partner changes and estimated duties.">
  <div class="page-heading"><p class="eyebrow">COFFEE / HS 090121</p><h1>Coffee release briefing</h1><p>Current pilot coverage: Roasted coffee (HS 090121).</p><p>A factual summary of the latest retained release, with links to the figures behind it.</p></div>
  <ReleaseBriefing release={release}/>
</BaseLayout>
