---
import ReleaseBriefingPage from '../components/ReleaseBriefingPage.astro';
import {loadPublishedReleases} from '../lib/trade/load-release';
import {DEFAULT_PRODUCT_CODE} from '../lib/trade/product-registry';
const profiles=await loadPublishedReleases(),profile=profiles.find(({product})=>product.code===DEFAULT_PRODUCT_CODE);
if(!profile)throw new Error('Default briefing product is not published');
---
<ReleaseBriefingPage {...profile} products={profiles.map(({product})=>product)}/>
