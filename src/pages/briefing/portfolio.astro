---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {PortfolioBriefing} from '../../components/PortfolioBriefing';
import {loadPublishedReleases} from '../../lib/trade/load-release';
import {preparePortfolioBriefing} from '../../lib/trade/portfolio-briefing';
const data=preparePortfolioBriefing(await loadPublishedReleases());
---
<BaseLayout title="Product portfolio briefing" description="Select the published products for a sourced U.S. trade briefing with partner changes and estimated duties.">
  <div class="page-heading"><p class="eyebrow">PRODUCT RESEARCH</p><h1>Product portfolio briefing</h1><p>Choose products and a trade direction for one sourced report.</p></div>
  <PortfolioBriefing data={data} client:load/>
</BaseLayout>
