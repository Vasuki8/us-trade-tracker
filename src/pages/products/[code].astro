---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ProductExplorerClient} from '../../components/ProductExplorerClient';
import {loadPublishedReleases} from '../../lib/trade/load-release';
import {encodeBrowserRelease} from '../../lib/trade/browser-release';
export async function getStaticPaths(){return (await loadPublishedReleases()).map(({product,release})=>({params:{code:product.code},props:{product,release}}));}
const {product,release}=Astro.props;
const description=release.observations.find(row=>row.geography==='world')?.description??'Product profile';
---
<BaseLayout title={`HS ${release.productCode} product profile`} productCode={release.productCode}>
  <div class="page-heading"><p class="eyebrow">PRODUCT RESEARCH / HS {release.productCode}</p><h1>{product.displayName}</h1><p>U.S. trade totals, partner countries and estimated duties.</p><details class="content-details product-definition"><summary>Product description</summary><p class="heading-description">{description}</p></details></div>
  <ProductExplorerClient data={encodeBrowserRelease(release)} client:load/>
</BaseLayout>
