---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {MexicoLocalProfile} from '../../../components/MexicoLocalProfile';
import {loadMexicoLocalProfile} from '../../../lib/mexico-profile/load.server';
import {mexicoProfileDescription} from '../../../lib/mexico-profile/presentation';
import '../../../styles/mexico-profile.css';
export async function getStaticPaths(){
 const profile=await loadMexicoLocalProfile();
 return profile?[{params:{code:'2010'},props:{profile}}]:[];
}
const {profile}=Astro.props;
---
<BaseLayout title="Mexico local all-goods preview" description={mexicoProfileDescription(profile)} robots="noindex,nofollow">
 <MexicoLocalProfile data={profile} client:load/>
</BaseLayout>
