---
import MonthlyChangesPage from '../components/MonthlyChangesPage.astro';
import {loadPublishedReleases} from '../lib/trade/load-release';
import {DEFAULT_PRODUCT_CODE} from '../lib/trade/product-registry';
const profiles=await loadPublishedReleases();
const selected=profiles.find(({product})=>product.code===DEFAULT_PRODUCT_CODE);
if(!selected)throw new Error('Default changes product is not published');
---
<MonthlyChangesPage {...selected} products={profiles.map(({product})=>product)}/>
