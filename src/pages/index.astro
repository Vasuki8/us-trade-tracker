---
import BaseLayout from '../layouts/BaseLayout.astro';import {loadPublishedReleases} from '../lib/trade/load-release';
import {DEFAULT_PRODUCT_CODE} from '../lib/trade/product-registry';
const profiles=await loadPublishedReleases();
const release=profiles.find(({product})=>product.code===DEFAULT_PRODUCT_CODE)!.release;
---
<BaseLayout title="Follow U.S. goods trade"><section class="home-hero"><p class="eyebrow">PRODUCTS. PARTNERS. PERSPECTIVE.</p><h1>Follow U.S.<br/>goods trade.</h1><p>Understand what changed in the products and markets you follow, using sourced monthly observations and clear comparisons.</p><div class="home-actions"><a class="primary-button" href={`/products/${release.productCode}/`}>Explore the coffee profile <span aria-hidden="true">→</span></a><a class="secondary-button" href="/changes/">See monthly changes</a></div><p class="hero-footnote">The first development profile · HS 090121</p></section>
<section class="home-intro"><div><p class="eyebrow">START WITH A PRODUCT</p><h2>A clearer view of<br/>your partner markets.</h2></div><div><p>Compare U.S. sourcing and export flows, follow their history, and take the displayed chart or data with you.</p><p>Every view carries its period, measure and source. The current pilot uses {release.source==='fixture'?'clearly labeled synthetic development data.':profiles.length>1?'validated Census releases.':'a validated Census release.'}</p><nav aria-label="Product profiles"><ul class="profile-links">{profiles.map(({product})=><li><a href={`/products/${product.code}/`}>{product.displayName} · HS {product.code}</a></li>)}</ul></nav><p><a href="/briefing/">Read the coffee briefing</a></p><a href="/methods/">Read the methods ↗</a></div></section></BaseLayout>
<style>.profile-links{list-style:none;padding:0;display:grid;gap:10px}.profile-links a{overflow-wrap:anywhere}</style>
