---
import BaseLayout from '../layouts/BaseLayout.astro';
import {TradeOverview} from '../components/TradeOverview';
import {loadPublishedReleases} from '../lib/trade/load-release';
import {buildOverviewProduct} from '../lib/trade/overview';
import {loadCanadaPilot} from '../lib/country-preview/pilot-load.server';
const profiles=await loadPublishedReleases();
const canadaPilot=await loadCanadaPilot();
const sample=profiles.some(({release})=>release.source==='fixture');
---
<BaseLayout title="U.S. trade overview">
  <div class="page-heading overview-heading"><div><p class="eyebrow">UNITED STATES / GOODS TRADE</p><h1>Trade overview</h1><p>Products, partner markets and monthly changes.</p></div><a class="secondary-button" href="/changes/products/">Compare product changes</a></div>
  {sample&&<div class="sample-banner"><strong>Development sample data</strong><span>These profiles use synthetic observations for development checks.</span></div>}
  <TradeOverview products={profiles.map(buildOverviewProduct)} client:load/>
  <nav class="home-research-links" aria-label="Research tools"><a href="/changes/">See monthly changes</a><a href="/briefing/portfolio/">Build a product briefing</a><a href="/briefing/">Read the coffee briefing</a><a href="/methods/">Read the methods ↗</a></nav>
  {canadaPilot&&<section class="data-card home-country" aria-labelledby="home-country-heading"><div><p class="eyebrow">COUNTRY RESEARCH</p><h2 id="home-country-heading">Country snapshot</h2><a href="/countries/1220/">Canada historical snapshot</a></div><div><strong>24 months</strong><p>September 2024–August 2026</p></div><div><strong>10 categories / direction</strong><p>All-goods history and selected categories.</p></div><details class="content-details"><summary>Snapshot coverage</summary><p>Source: {canadaPilot.data.source==='fixture'?'Synthetic development data':'U.S. Census Bureau monthly merchandise files'}. Fixed historical snapshot; no monthly update schedule.</p></details></section>}
</BaseLayout>
