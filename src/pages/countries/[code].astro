---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {CanadaPreview} from '../../components/CanadaPreview';
import {MexicoLocalProfile} from '../../components/MexicoLocalProfile';
import {loadCanadaPilot} from '../../lib/country-preview/pilot-load.server';
import {loadMexicoPilot} from '../../lib/mexico-profile/pilot-load.server';
import {mexicoProfileDescription} from '../../lib/mexico-profile/presentation';
import '../../styles/mexico-profile.css';
export async function getStaticPaths(){
 const canada=await loadCanadaPilot(),mexico=await loadMexicoPilot();
 return [
  ...(canada?[{params:{code:'1220'},props:{kind:'canada' as const,pilot:canada,mexicoAvailable:Boolean(mexico)}}]:[]),
  ...(mexico?[{params:{code:'2010'},props:{kind:'mexico' as const,profile:mexico,mexicoAvailable:true}}]:[]),
 ];
}
const view=Astro.props;
const title=view.kind==='mexico'?'Mexico historical all-goods snapshot':'Canada historical snapshot';
const description=view.kind==='mexico'?mexicoProfileDescription(view.profile):'Captured U.S. goods trade with Canada, September 2024–August 2026.';
---
<BaseLayout title={title} description={description} robots="noindex,nofollow">
 {view.mexicoAvailable&&<nav class="home-research-links" aria-label="Country snapshots">{view.kind==='mexico'?<a href="/countries/1220/">Canada historical snapshot</a>:<a href="/countries/2010/">Mexico all-goods snapshot</a>}</nav>}
 {view.kind==='mexico'?<MexicoLocalProfile data={view.profile} client:load/>:<CanadaPreview data={view.pilot.data} presentation={view.pilot.presentation} enableSharing={view.pilot.presentation.kind==='pilot-snapshot'||view.pilot.presentation.kind==='pilot-fixture'} client:load/>}
</BaseLayout>
