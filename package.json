{
  "name": "us-trade-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "data:import": "node --env-file-if-exists=.env --import tsx scripts/import-product.ts",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@astrojs/react": "7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.0.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.2",
    "@playwright/test": "1.64.0",
    "tsx": "4.23.15"
  }
}
