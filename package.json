{
  "name": "us-trade-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "build": "astro build",
    "build:report": "node --import tsx scripts/build-report.ts",
    "check": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "data:import": "node --env-file-if-exists=.env --import tsx scripts/import-product.ts",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "data:archive": "node --import tsx scripts/archive-product.ts",
    "data:verify-archive": "node --import tsx scripts/verify-archive.ts",
    "data:audit-duties": "node --import tsx scripts/audit-duties.ts",
    "data:audit-country": "node --import tsx scripts/audit-country.ts",
    "data:probe-country": "node --import tsx scripts/probe-country.ts",
    "data:diagnose-country": "node --import tsx scripts/diagnose-country.ts",
    "data:probe-aggregates": "node --import tsx scripts/probe-country-aggregates.ts",
    "data:probe-totals": "node --import tsx scripts/probe-country-totals.ts",
    "data:probe-prefix": "node --import tsx scripts/probe-country-prefix.ts",
    "data:probe-partitions": "node --import tsx scripts/probe-country-partitions.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@aws-sdk/client-s3": "3.1148.0",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
